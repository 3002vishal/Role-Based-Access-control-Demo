[NewRequest]
Subject = "CN=Vishalku, O=MyCompany, C=IN"
KeyLength = 2048
; *** CRITICAL CHANGE: Set to 2 (Signature Only) ***
; Most Moserbear tokens REJECT requests with KeySpec=1
KeySpec = 2
KeyUsage = 0xA0
MachineKeySet = FALSE
Exportable = FALSE
RequestType = PKCS10
SMIME = FALSE

; *** USE THE DRIVER WE KNOW WORKS FOR READING ***
ProviderName = "SafeSign Standard Cryptographic Service Provider"
ProviderType = 1

; Force a specific container so we can find it easily later
KeyContainer = "VishalAK"

[EnhancedKeyUsageExtension]
OID=1.3.6.1.5.5.7.3.2