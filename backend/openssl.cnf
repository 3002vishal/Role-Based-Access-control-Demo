[ ca ]
default_ca = CA_default

[ CA_default ]
dir               = ./demoCA/root
certs             = $dir/certs
new_certs_dir     = $dir/newcerts
database          = $dir/index.txt
serial            = $dir/serial
private_key       = $dir/private/ca.key.pem
certificate       = $dir/ca.cert.pem
default_md        = sha256
policy            = policy_strict
default_days      = 365

# Security: Do NOT copy extensions from the CSR. We want the CA to add them.
copy_extensions   = none

[ policy_strict ]
countryName             = match
stateOrProvinceName     = optional
organizationName        = optional
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

# ===========================================================
# ROOT CA EXTENSIONS
# ===========================================================
[ v3_ca ]
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints = critical, CA:true
keyUsage = critical, cRLSign, keyCertSign

# ===========================================================
# INTERMEDIATE CA EXTENSIONS
# ===========================================================
[ v3_intermediate_ca ]
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints = critical, CA:true, pathlen:0
keyUsage = critical, cRLSign, keyCertSign

# ===========================================================
# SERVER CERTIFICATE EXTENSIONS
# ===========================================================
[ server_cert ]
basicConstraints = CA:FALSE
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

# ===========================================================
# STANDARD CLIENT CERTIFICATE (NO ROLES)
# ===========================================================
[ usr_cert ]
basicConstraints = CA:FALSE
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = clientAuth

# ===========================================================
# DYNAMIC CLIENT CERTIFICATE (INJECTS ROLES FROM ENV VAR)
# ===========================================================
# Use this extension when signing via Node.js:
# openssl ca ... -extensions usr_cert_dynamic
#
# IMPORTANT: You must set the SERVICE_ROLES environment variable 
# in your Node.js code before spawning the openssl process.
# ===========================================================
[ usr_cert_dynamic ]
basicConstraints = CA:FALSE
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = clientAuth

# YOUR CUSTOM OID FOR ROLES
# The value is pulled from the environment variable 'SERVICE_ROLES'
# Example value: '{"ZTA":"Admin", "PKI":"Viewer"}'
1.2.3.4.5.6.7.8.1 = ASN1:UTF8String:$ENV::SERVICE_ROLES